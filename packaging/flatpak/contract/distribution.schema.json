{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Luminus distribution contracts v1",
  "oneOf": [{"$ref": "#/$defs/release"}, {"$ref": "#/$defs/imagePins"}],
  "$defs": {
    "version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-rc\\.[1-9][0-9]*)?$(?![\\s\\S])"},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$(?![\\s\\S])"},
    "channel": {"enum": ["stable", "testing"]},
    "architecture": {"enum": ["x86_64", "aarch64"]},
    "application": {"enum": ["dev.luminusos.ZapTide", "org.luminusos.Aetheris", "sirius-installer"]},
    "artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["artifact_id", "filename", "sha256", "size_bytes"],
      "properties": {
        "artifact_id": {"type": "integer", "minimum": 1},
        "filename": {"type": "string", "maxLength": 200, "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$(?![\\s\\S])"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"type": "integer", "minimum": 1}
      }
    },
    "release": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "kind", "format", "application", "source", "version", "artifacts"],
      "properties": {
        "schema_version": {"const": 1}, "kind": {"const": "release"},
        "format": {"enum": ["flatpak", "rpm"]},
        "application": {"$ref": "#/$defs/application"},
        "version": {"$ref": "#/$defs/version"},
        "source": {
          "type": "object", "additionalProperties": false,
          "required": ["repository", "tag", "revision", "workflow", "run_id", "run_attempt"],
          "properties": {
            "repository": {"type": "string"}, "workflow": {"type": "string"},
            "tag": {"type": "string", "pattern": "^v(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-rc\\.?[1-9][0-9]*)?$(?![\\s\\S])"},
            "revision": {"type": "string", "pattern": "^[a-f0-9]{40}$(?![\\s\\S])"},
            "run_id": {"type": "integer", "minimum": 1},
            "run_attempt": {"type": "integer", "minimum": 1}
          }
        },
        "artifacts": {
          "type": "object", "additionalProperties": false, "required": ["x86_64", "aarch64"],
          "properties": {"x86_64": {"$ref": "#/$defs/artifact"}, "aarch64": {"$ref": "#/$defs/artifact"}}
        }
      },
      "allOf": [
        {"if": {"properties": {"application": {"const": "dev.luminusos.ZapTide"}}},
         "then": {"properties": {"format": {"const": "flatpak"}, "source": {"properties": {
           "repository": {"const": "luminusOS/zaptide"}, "workflow": {"const": ".github/workflows/release.yml"}
         }}}}},
        {"if": {"properties": {"application": {"const": "org.luminusos.Aetheris"}}},
         "then": {"properties": {"format": {"const": "flatpak"}, "source": {"properties": {
           "repository": {"const": "luminusOS/aetheris"}, "workflow": {"const": ".github/workflows/release-flatpak.yml"}
         }}}}},
        {"if": {"properties": {"application": {"const": "sirius-installer"}}},
         "then": {"properties": {"format": {"const": "rpm"}, "source": {"properties": {
           "repository": {"const": "luminusOS/sirius"}, "workflow": {"const": ".github/workflows/ci.yml"}
         }}}}}
      ]
    },
    "imagePins": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "kind", "image", "pins"],
      "properties": {
        "schema_version": {"const": 1}, "kind": {"const": "image-pins"},
        "image": {
          "type": "object", "additionalProperties": false,
          "required": ["reference", "digest", "channel", "architecture"],
          "properties": {
            "reference": {"type": "string", "maxLength": 255, "pattern": "^[a-z0-9]+([.-][a-z0-9]+)*(/[a-z0-9]+([._-][a-z0-9]+)*)+$(?![\\s\\S])"},
            "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$(?![\\s\\S])"},
            "channel": {"$ref": "#/$defs/channel"}, "architecture": {"$ref": "#/$defs/architecture"}
          }
        },
        "pins": {"type": "array", "minItems": 1, "maxItems": 3, "items": {"$ref": "#/$defs/pin"}}
      }
    },
    "pin": {
      "type": "object", "additionalProperties": false,
      "required": ["format", "application", "channel", "version", "url", "sha256", "fallback"],
      "properties": {
        "format": {"enum": ["flatpak", "rpm"]}, "application": {"$ref": "#/$defs/application"},
        "channel": {"$ref": "#/$defs/channel"}, "version": {"$ref": "#/$defs/version"},
        "sha256": {"$ref": "#/$defs/sha256"}, "fallback": {"enum": ["none", "stable-approved"]},
        "url": {"type": "string", "maxLength": 1024, "pattern": "^https://(flatpak|rpm)\\.luminusos\\.org/[A-Za-z0-9._/-]+$(?![\\s\\S])"},
        "rpm": {
          "type": "object", "additionalProperties": false,
          "required": ["name", "epoch", "version", "release", "fedora"],
          "properties": {
            "name": {"const": "sirius-installer"}, "epoch": {"type": "integer", "minimum": 0},
            "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(~rc\\.[1-9][0-9]*)?$(?![\\s\\S])"},
            "release": {"type": "string", "maxLength": 100, "pattern": "^[A-Za-z0-9][A-Za-z0-9._+~]*$(?![\\s\\S])"},
            "fedora": {"const": 45}
          }
        },
        "flatpak": {
          "type": "object", "additionalProperties": false, "required": ["ref", "commit"],
          "properties": {
            "ref": {"type": "string", "pattern": "^app/(dev\\.luminusos\\.ZapTide|org\\.luminusos\\.Aetheris)/(x86_64|aarch64)/(stable|testing)$(?![\\s\\S])"},
            "commit": {"$ref": "#/$defs/sha256"}
          }
        }
      },
      "oneOf": [
        {"required": ["rpm"], "not": {"required": ["flatpak"]}, "properties": {
          "format": {"const": "rpm"}, "application": {"const": "sirius-installer"}
        }},
        {"required": ["flatpak"], "not": {"required": ["rpm"]}, "properties": {
          "format": {"const": "flatpak"}, "application": {"enum": ["dev.luminusos.ZapTide", "org.luminusos.Aetheris"]}
        }}
      ]
    }
  }
}
